# Fillbook Growth OS backend — copy to .env.local and fill in real values.
# Never commit .env.local. Secrets live only here locally / in Vercel's
# encrypted project env vars, never in the Android app.

SUPABASE_URL=https://aijnibayogdygtykidta.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# X (Signal Graph adapter — mentions/engagement for @FillbookHQ, Owned
# Reads pricing). Client ID/Secret come from the X Developer Console app's
# OAuth 2.0 Keys. Access/Refresh Token come from that same page's "Access
# Token > Generate" (scopes: tweet.read, users.read, offline.access only
# — no write scopes, no DM scopes). These only bootstrap the very first
# run; after that the adapter persists refreshed tokens to the
# platform_oauth_credentials table itself, since a serverless invocation
# can't write back to its own env vars.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Google (Search Console signals). Project "Fillbook Growth OS" in Google
# Cloud Console, Search Console API enabled. Must be authorized as
# whichever Google account actually owns the verified Search Console
# property -- not necessarily the account that owns the Cloud project.
# Scope: webmasters.readonly. Same bootstrap-then-self-persist pattern as
# the X credentials above. (The YouTube Data API scope this token pair
# once also carried is no longer used -- YouTube/TikTok signal ingestion
# was removed; TikTok distribution still goes through Fliki. YouTube
# publishing came back as its own automated flow, 2026-09-22, but uses a
# SEPARATE token pair -- see YOUTUBE_ACCESS_TOKEN/YOUTUBE_REFRESH_TOKEN
# below, not this one.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# YouTube publishing + analytics pull-back (2026-09-22, reversing the
# Fliki-only decision noted above -- YouTube only, TikTok still goes
# through Fliki). Uses its OWN dedicated OAuth client (same Google Cloud
# project, different Client ID/Secret from GOOGLE_OAUTH_CLIENT_ID/SECRET
# above): the redesigned Google Cloud Credentials UI no longer exposes a
# way to view or reset an existing client's secret, so a fresh client was
# created for this rather than reusing the Search Console one.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Needs its OWN access/refresh token pair too: a Google refresh token's
# scopes are fixed at consent time, and the Search Console token above was
# only ever authorized for webmasters.readonly. Generate this pair by
# running an OAuth consent flow for the client above with scopes
# https://www.googleapis.com/auth/youtube.upload and
# https://www.googleapis.com/auth/yt-analytics.readonly, authorized as the
# Google account that owns/manages the target YouTube channel (a manual
# owner step -- see docs/PROGRESS_LEDGER.md). These only bootstrap the
# first run; after that youtubeTokenStore.ts persists refreshed tokens to
# platform_oauth_credentials (platform="youtube") itself.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
# Set to "true" to enable automated publishing of rendered videos to
# YouTube (render-single.ts) and the analytics pull-back
# (api/daily-pipeline.ts). Unset/anything else keeps both a no-op -- safe
# to merge and deploy before the OAuth tokens above exist.
YOUTUBE_PUBLISHING_ENABLED=

# TikTok Content Posting API -- automated video drafting (2026-09-22,
# replacing the now-canceled Fliki as TikTok's distribution path). Uses
# TikTok's "upload to inbox" endpoint, not Direct Post: this drops the
# rendered video into the creator's TikTok inbox as a draft that the owner
# still has to open the app, caption, and post themselves -- an
# EXTERNAL_DRAFT under docs/EXTERNAL_WRITE_FIREWALL.md, not an autonomous
# publish (tiktok.publish_video/Direct Post stays permanently rejected).
# The TikTok for Developers app must have the "Content Posting API"
# product added with the video.publish scope (the existing app used for
# read-only signal ingestion likely only has user.info.basic/video.list --
# check before assuming these credentials already work for publishing).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok rotates the refresh token on every use -- these only bootstrap
# the first run; after that tiktokTokenStore.ts persists refreshed tokens
# (including the new refresh_token) to platform_oauth_credentials
# (platform="tiktok") itself.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Set to "true" to enable automated TikTok drafting (render-single.ts) and
# draining the publish queue (api/daily-pipeline.ts). Unset/anything else
# keeps both a no-op.
TIKTOK_PUBLISHING_ENABLED=

# AI provider key -- deep content-review agents (Phase 6: trader,
# hook_specialist, copy_editor, skeptic, brand_guardian, growth_strategist,
# fact_checker, integrity_reviewer, conversion_reviewer). Create a key at
# platform.claude.com/settings/keys. Console now issues identity-linked
# keys by default, which require the workspace they act in on every
# request -- find yours at platform.claude.com/settings/workspaces (the
# "ID" column loads async; if it stays blank, reload). Omitting
# ANTHROPIC_WORKSPACE_ID fails with "anthropic-workspace-id is required
# when authenticating with an identity-linked API key".
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Scheduling (backend/src/config/scheduleConfig.ts) -- the single source of
# truth for when X prospecting/inbound run, and what timezone their times
# are expressed in. All are optional; each falls back to the approved
# default schedule if unset. America/Phoenix never observes DST, so a
# fixed-UTC external scheduler (see .github/workflows/growth-pulse.yml)
# stays correct year-round without a seasonal adjustment -- changing this
# to a DST-observing zone would require also updating that workflow file's
# cron lines (see its own comment).
SCHEDULE_TIMEZONE=America/Phoenix
X_PROSPECTING_TIMES=08:00,13:00,18:00
X_INBOUND_TIMES=08:00,13:00,18:00

# Authorizes calls to /api/daily-pipeline and /api/growth-pulse, the
# scheduled entry points (see vercel.json and
# .github/workflows/growth-pulse.yml). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The SAME value must also be added as a GitHub Actions repo secret
# (Settings -> Secrets and variables -> Actions -> New repository secret)
# named CRON_SECRET, plus a second secret BACKEND_BASE_URL (this project's
# live Vercel URL, e.g. https://fillbook-growth-os.vercel.app) -- both are
# manual owner steps (see docs/PROGRESS_LEDGER.md), never something this
# codebase can set for itself.
CRON_SECRET=

# Gates POST /api/ingest?source=fillbook_signup, the webhook FillbookHQ's
# own signup flow calls so Growth OS can close the attribution loop
# (which UTM campaign / referral code actually produced a signup). Called
# from a browser bundle (fillbook/frontend), not a backend, so this is
# NOT a real secret -- anyone can read it out of that site's JS. It only
# gates writes into THIS project's own conversion_events table; it can
# never read or write anything in FillbookHQ's database (see
# docs/ARCHITECTURE.md's isolation goal). Generate the same way as
# CRON_SECRET, then also set it as VITE_GROWTH_OS_WEBHOOK_SECRET in the
# fillbook/frontend repo's own env (a manual owner step in that repo).
FILLBOOK_WEBHOOK_SECRET=


# Optional -- src/email/emailClient.ts's outreach-email scaffold (not wired
# into any endpoint yet, see that file's doc comment). Use a Resend API key
# under its OWN sending identity (e.g. growth@fillbookhq.com), separate
# from whatever key fillbookhq/frontend uses for transactional email, so a
# bulk outreach send's deliverability can never affect password-reset/
# receipt emails. OUTREACH_FROM_EMAIL must be a verified sender in Resend.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# Stock video footage for rendered videos (backend/scripts/video-factory/
# stockFootage.ts) -- searches Pexels AND Pixabay together (2026-09-11;
# previously Pexels only), both free/self-serve APIs, so the effective
# clip pool is the union of both libraries. These are only ever used by
# the GitHub Actions video-render workflow (as repo secrets, not here) --
# listed for local reference/local CLI rendering only. Either may be left
# unset; video generation just searches whichever provider(s) have a key,
# and falls back to a solid background (never a hard failure) if neither
# does or nothing matches.
# Pexels: pexels.com/api/new/ (instant, free).
PEXELS_API_KEY=
# Pixabay: pixabay.com/api/docs/ (shown at the top once logged in; instant, free).
PIXABAY_API_KEY=

# Live Host worker (docs/LIVE_HOST.md). Read by `npm run live-host` on the
# owner's PC, NOT by Vercel. The worker holds only the automation token: it
# can tick and confirm spoken lines, never flip the switch or edit settings.
# Same value as APP_API_TOKEN_AUTOMATION on the server (32+ characters).
GROWTH_OS_AUTOMATION_TOKEN=
# Vercel deployment-protection bypass secret, the same one the Android app sends.
GROWTH_OS_PROTECTION_BYPASS_SECRET=
# Defaults to the production backend.
GROWTH_OS_BASE_URL=https://fillbook-growth-os.vercel.app
# OBS > Tools > WebSocket Server Settings. Set OBS_WEBSOCKET_URL=off to start
# and stop the stream in OBS by hand instead.
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
# Set to off to start and stop the stream in OBS yourself; the worker still keeps the stage page loaded.
LIVE_HOST_OBS_STREAM=on
# Where OBS is streaming: youtube, tiktok or both. The host only says the website out loud on "youtube";
# anything else (or leaving it unset) makes it say "link in bio", which is what TikTok requires.
LIVE_HOST_PLATFORM=tiktok
# Optional: stage port, voice and pace.
LIVE_HOST_PORT=8790
LIVE_HOST_VOICE=en-US-AndrewNeural
LIVE_HOST_RATE=+4%
